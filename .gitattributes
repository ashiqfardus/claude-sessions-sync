# Normalise to LF in the repository regardless of the contributor's platform.
* text=auto eol=lf

# Transcripts are UTF-8 JSON Lines with LF endings; never let a checkout rewrite them.
*.jsonl -text

*.png binary
*.pdf binary
*.woff2 binary
# goldens are byte-exact output (some hold a lone CR from progress lines)
cmd/claude-sessions/testdata/golden/*.txt -text
